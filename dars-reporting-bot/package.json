{
  "name": "dars-reporting-bot",
  "version": "1.0.0",
  "description": "Automated DARS reporting bot for BUCC via Cloudflare Workers and Telegram",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute dars-db --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^3.78.10"
  }
}
